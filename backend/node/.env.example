# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / SQLite fallback for local test)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moon_tech_db
DB_USER=root
DB_PASSWORD=root
DB_DIALECT=mysql

# JWT Security
JWT_SECRET=moon_tech_jwt_secret_key_super_secure_2026_phase1
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=moon_tech_jwt_refresh_secret_key_phase1_secure
JWT_REFRESH_EXPIRES_IN=7d

# AES-256 Data Encryption Key (Must be 32 bytes hex or string)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# URLs & CORS
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
# Extra allowed browser origins, comma-separated (production domains)
CORS_ORIGINS=
# Set to 1 when running behind nginx / a load balancer
TRUST_PROXY=0

# Storage
UPLOAD_DIR=./storage/kyc_documents
MAX_FILE_SIZE_MB=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# SMTP / Email Configuration (Placeholder / Ready for SMTP service)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@moontech.com
# Mailbox notified when a customer writes in the support chat (falls back to EMAIL_FROM)
SUPPORT_EMAIL=support@moontech.com
